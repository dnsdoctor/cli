{
  "name": "dns-doctor",
  "version": "0.5.2",
  "description": "DNS Doctor from the terminal: find out why a domain's email lands in spam, get the exact DNS record to fix it and check the change is live everywhere. SPF, DMARC, DKIM, MX, propagation, blacklists and expiry. Fix records come from a validating engine, never an AI guess.",
  "license": "Apache-2.0",
  "author": {
    "name": "DNS Doctor",
    "url": "https://dnsdoctor.dev"
  },
  "homepage": "https://dnsdoctor.dev/methodology",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsdoctor/cli.git"
  },
  "keywords": [
    "dns",
    "dmarc",
    "spf",
    "dkim",
    "email",
    "deliverability",
    "propagation",
    "cli"
  ],
  "type": "module",
  "bin": {
    "dns-doctor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
